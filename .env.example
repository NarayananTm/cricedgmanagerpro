# Copy this file to .env and replace all placeholders with your local values.
# Never commit populated secrets or connection strings.
DATABASE_URL=postgresql://YOUR_USERNAME:YOUR_PASSWORD@YOUR_HOST:PORT/YOUR_DATABASE?sslmode=require

# Optional CA certificate contents for private/custom certificate chains.
# Use \n for line breaks.
# PGSSL_CA=

# Required for Gemini AI API calls.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# APP_URL: The URL where this applet is hosted.
APP_URL=http://localhost:3000
